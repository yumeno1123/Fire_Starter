{
  "name": "flcl-fire-starter",
  "version": "1.0.0",
  "description": "FLCL Fire Starter Mobile Web Game PWA",
  "main": "js/main.js",
  "type": "module",
  "scripts": {
    "test": "node --test test/*.test.js",
    "start": "node -e \"const http=require('http'),fs=require('fs'),path=require('path');http.createServer((req,res)=>{let f=req.url==='/'?'/index.html':req.url;f=path.join(__dirname,decodeURIComponent(f.split('?')[0]));if(fs.existsSync(f)&&fs.statSync(f).isFile()){const ext=path.extname(f);const mime={'html':'text/html','css':'text/css','js':'text/javascript','json':'application/json','png':'image/png','ico':'image/x-icon','webmanifest':'application/manifest+json'}[ext.slice(1)]||'text/plain';res.writeHead(200,{'Content-Type':mime+'; charset=utf-8'});fs.createReadStream(f).pipe(res);}else{res.writeHead(404);res.end('Not Found');}}).listen(8080,()=>console.log('Server running on http://localhost:8080'));\""
  },
  "keywords": [
    "flcl",
    "fire-starter",
    "pwa",
    "canvas",
    "retro-game"
  ],
  "author": "Antigravity",
  "license": "MIT"
}
